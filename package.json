{
  "name": "ezra-mail-agent",
  "version": "0.8.2",
  "description": "Private, local-first email intelligence with a calm reader, trusted devices, local AI, smart triage, and exact-review replies.",
  "private": false,
  "author": "Eric Michael Mathews",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/R3dTh3Ging3r-s-Creations/Ezra-Mail-Self-Hosted.git"
  },
  "overrides": {
    "postcss": "8.5.25",
    "nanoid": "3.3.18",
    "sharp": "0.35.4",
    "uuid": "^11.1.1",
    "tmp": "^0.2.6"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "postinstall": "node scripts/apply-dependency-patches.mjs",
    "start": "next start -H 127.0.0.1",
    "worker": "tsx scripts/email-worker.ts",
    "mcp": "tsx scripts/mcp-server.ts",
    "benchmark:models": "tsx scripts/model-benchmark.ts",
    "model:update": "tsx scripts/update-model.ts",
    "models:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-models.ps1",
    "startup:install": "powershell -ExecutionPolicy Bypass -File scripts/install-startup.ps1",
    "tray": "powershell -ExecutionPolicy Bypass -File scripts/ezra-tray.ps1",
    "installer:run": "powershell -ExecutionPolicy Bypass -File installer/EzraMailSetup.ps1",
    "install:verify": "tsx scripts/verify-install-release.ts",
    "auth:hash": "tsx scripts/hash-auth-password.ts",
    "auth:bootstrap": "tsx scripts/first-owner-bootstrap.ts",
    "auth:recover": "tsx scripts/recover-owner-auth.ts",
    "backup:verify": "tsx scripts/verify-latest-backup.ts",
    "backup:create": "tsx scripts/create-email-backup.ts",
    "backup:rehearse": "tsx scripts/rehearse-email-restore.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "posttest": "node scripts/cleanup-test-databases.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "branding:generate": "node scripts/generate-branding-assets.mjs",
    "license:check": "tsx scripts/check-dependency-licenses.ts --check",
    "license:report": "tsx scripts/check-dependency-licenses.ts --write docs/DEPENDENCY_LICENSES.md",
    "public:scan": "tsx scripts/build-public-mirror.ts --scan-only",
    "public:export": "tsx scripts/build-public-mirror.ts --output PRIVATE_OWNER_RECOVERY/workspaces/public-mirror --clean"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@simplewebauthn/server": "13.3.2",
    "exceljs": "4.4.1-prerelease.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "next": "15.5.25",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.6",
    "tsx": "^4.22.4",
    "web-push": "3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.53.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/spdx-expression-parse": "4.0.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^25.0.1",
    "license-checker-rseidelsohn": "4.4.2",
    "spdx-expression-parse": "4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  }
}
