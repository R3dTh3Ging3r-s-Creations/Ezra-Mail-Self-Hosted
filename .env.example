APP_BASE_URL=http://127.0.0.1:3000
EZRA_EMAIL_DATABASE_URL=file:./data/ezra-mail.sqlite
# First-owner setup creates the signing secret and owner password configuration.
# Leave these blank; normal installation never requires pasting a password hash.
EZRA_AUTH_PASSWORD_HASH=
EZRA_AUTH_PASSWORD_HASH_B64=
EZRA_AUTH_SECRET=
EZRA_AUTH_SECURE_COOKIE=true
EZRA_OPENCLAW_WORKSPACE=./data/assistant-memory
GOG_PATH=C:\Users\YOUR_USER\AppData\Local\Programs\gog\gog.exe
GMAIL_ACCOUNTS=
GMAIL_SEARCH_QUERY=in:inbox newer_than:2d
GMAIL_POLL_MAX=50
GMAIL_BACKLOG_QUERY=in:inbox is:unread
GMAIL_BACKLOG_BATCH=25
GMAIL_BACKLOG_MODEL_BUDGET=3
GMAIL_BACKLOG_INTERVAL_MINUTES=15
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT=common
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
EZRA_BROWSER_NOTIFICATIONS_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional override: ollama/ followed by an exact installed model name.
EZRA_EMAIL_MODEL_REF=
OLLAMA_NUM_CTX=40960
OLLAMA_TIMEOUT_MS=300000
OLLAMA_BACKGROUND_KEEP_ALIVE=30s
OLLAMA_INTERACTIVE_KEEP_ALIVE=2m

# Optional Web Push: configure only if you choose to enable external relay delivery.
# Keep all private material outside Git and SQLite; never reuse EZRA_AUTH_SECRET.
# A current key ID is 1..32 letters/digits/_/-. Encryption key: unpadded base64url, 32 bytes.
EZRA_PUSH_KEY_ID=
EZRA_PUSH_ENCRYPTION_KEY=
# Optional JSON array, max 4 entries: [{"keyId":"YOUR_OLD_KEY_ID","key":"YOUR_OLD_ENCRYPTION_KEY"}]
# Rotate encryption by assigning NEW key material a NEW unique ID and retaining the
# old ID/key here until lazy rewrap has completed. Never reuse an ID for new material.
EZRA_PUSH_OLD_KEYS_JSON=
# VAPID public key: uncompressed P-256, 65 bytes; matching private key: 32 bytes.
# Both are unpadded base64url. Subject: mailto contact or HTTPS origin.
# Changing VAPID identity requires explicit browser subscription again.
EZRA_VAPID_PUBLIC_KEY=
EZRA_VAPID_PRIVATE_KEY=
EZRA_VAPID_SUBJECT=
